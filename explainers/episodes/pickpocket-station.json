    {"text": "600 people. One pickpocket. 15 seconds. Find him.", "scene": "station", "chapter": "OBSERVATION TEST", "note": "",
      "events": [{"cue": "Find", "kind": "go"}]},
    {"text": "Stop! Did you find him?", "scene": "station", "chapter": "TIME'S UP", "note": "", "pause": 15.0,

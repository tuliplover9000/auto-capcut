{
  "id": "irredeemable",
  "voice": "en-US-AndrewNeural",
  "rate": "+0%",
  "title": "GTA 6 Irredeemable, but in real life: how courts rank criminals",
  "hot": ["gta", "irredeemable", "forever", "real", "six", "points", "three", "two", "one", "four", "turn", "c", "thirteen", "twelve", "short", "eight", "drug", "again", "career", "automatically", "forget", "fifteen", "never"],
  "lines": [
    {"text": "In GTA 6, go too far and the game ranks you Irredeemable. Forever.", "scene": "gta", "chapter": "GTA 6", "note": "",
      "events": [{"cue": "ranks", "kind": "tiers"}, {"cue": "Irredeemable", "kind": "shatter"}, {"cue": "Forever", "kind": "forever"}]},
    {"text": "Real federal courts rank criminals too. One to six.", "scene": "court", "chapter": "REAL LIFE", "note": "", "pause": 0.2,
      "events": [{"cue": "Real", "kind": "court"}, {"cue": "One", "kind": "scale"}]},
    {"text": "Every past sentence adds points.", "scene": "court", "chapter": "THE POINTS", "note": "", "pause": 0.15,
      "events": [{"cue": "points", "kind": "pts"}]},
    {"text": "Over thirteen months in prison? Three points.", "scene": "court", "chapter": "THE POINTS", "note": "", "pause": 0.15,
      "events": [{"cue": "prison", "kind": "r3"}, {"cue": "Three", "kind": "p3"}]},
    {"text": "Sixty days or more behind bars? Two.", "scene": "court", "chapter": "THE POINTS", "note": "", "pause": 0.15,
      "events": [{"cue": "Sixty", "kind": "r2"}, {"cue": "Two", "kind": "p2"}]},
    {"text": "Anything less, even probation? One. But only four of those count.", "scene": "court", "chapter": "THE POINTS", "note": "", "pause": 0.15,
      "events": [{"cue": "probation", "kind": "r1"}, {"cue": "One", "kind": "p1"}, {"cue": "four", "kind": "cap"}]},
    {"text": "Thirteen points, and you're Category six. The top.", "scene": "court", "chapter": "THE POINTS", "note": "", "pause": 0.2,
      "events": [{"cue": "Thirteen", "kind": "thirteen"}, {"cue": "top", "kind": "top"}]},
    {"text": "Your turn. Which one is Category six?", "scene": "court", "chapter": "YOUR TURN", "note": "", "pause": 0.3,
      "events": [{"cue": "turn", "kind": "test"}, {"cue": "six", "kind": "ask"}]},
    {"text": "C! Three, three, two, two, two, one. Thirteen.", "scene": "court", "chapter": "THE ANSWER", "note": "", "pause": 10.0,
      "events": [{"cue": "C", "kind": "answer"}, {"cue": "Thirteen", "kind": "csum"}]},
    {"text": "B's four prison terms? Twelve. One short.", "scene": "court", "chapter": "THE ANSWER", "note": "", "pause": 0.2,
      "events": [{"cue": "four", "kind": "b"}, {"cue": "Twelve", "kind": "bsum"}]},
    {"text": "And A's long list? The small stuff caps at four. Eight points.", "scene": "court", "chapter": "THE ANSWER", "note": "", "pause": 0.2,
      "events": [{"cue": "list", "kind": "a"}, {"cue": "caps", "kind": "acap"}, {"cue": "Eight", "kind": "asum"}]},
    {"text": "But two of A's are drug felonies. Caught selling again?", "scene": "court", "chapter": "THE TWIST", "note": "", "pause": 0.3,
      "events": [{"cue": "drug", "kind": "drug"}, {"cue": "again", "kind": "again"}]},
    {"text": "Career offender. Category six, automatically.", "scene": "court", "chapter": "THE TWIST", "note": "", "pause": 0.15,
      "events": [{"cue": "Career", "kind": "career"}, {"cue": "automatically", "kind": "auto"}]},
    {"text": "Unlike GTA, real courts forget. Old sentences stop counting after ten to fifteen years.", "scene": "court", "chapter": "REAL LIFE", "note": "", "pause": 0.35,
      "events": [{"cue": "forget", "kind": "forget"}, {"cue": "fifteen", "kind": "years"}]},
    {"text": "GTA 6 never does.", "scene": "gta", "chapter": "GTA 6", "note": "", "pause": 0.25,
      "events": [{"cue": "never", "kind": "never"}]}
  ]
}

    {
      "text": "Jensen Huang versus Thomas Edison. A hundred and fifty years apart. One fight.",
      "note": "Cartoon parody · every move is a real fact",
      "events": [
        {
          "cue": "$end",
          "kind": "fight"
        }
      ]
    },
    {
      "text": "Edison strikes first. One thousand and ninety-three patents.",
      "note": "Edison held 1,093 U.S. patents",
      "pause": 0.55,
      "events": [
        {
          "cue": "one",
          "kind": "move",
          "who": "R",
          "name": "PATENT STORM"
        },
        {
          "cue": "patents",
          "kind": "volley",
          "who": "R",
          "sprite": "paper",
          "dmg": 30
        }
      ]
    },
    {
      "text": "Jensen planned Nvidia in a Denny's booth. So he throws a Grand Slam.",
      "note": "Nvidia was planned at a San Jose Denny's in 1993",
      "events": [
        {
          "cue": "so",
          "kind": "move",
          "who": "L",
          "name": "GRAND SLAM"
        },
        {
          "cue": "slam",
          "kind": "volley",
          "who": "L",
          "sprite": "pancake",
          "dmg": 30
        }
      ]
    },
    {
      "text": "Edison flips on the light bulb. Which he didn't technically invent.",
      "note": "Earlier bulbs existed · Edison's 1879 bulb was the first practical one",
      "events": [
        {
          "cue": "flips",
          "kind": "move",
          "who": "R",
          "name": "LIGHT BULB"
        },
        {
          "cue": "bulb",
          "kind": "flash",
          "who": "R",
          "dmg": 35
        }
      ]
    },
    {
      "text": "Jensen's hurt. So he zips up the leather jacket.",
      "note": "His keynote uniform",
      "events": [
        {
          "cue": "so",
          "kind": "move",
          "who": "L",
          "name": "LEATHER JACKET"
        },
        {
          "cue": "jacket",
          "kind": "armor",
          "who": "L",
          "text": "DEFENSE +100"
        }
      ]
    },
    {
      "text": "Then his famous line. The more you buy, the more you save.",
      "note": "A real Jensen keynote line (SIGGRAPH 2018, GTC 2024)",

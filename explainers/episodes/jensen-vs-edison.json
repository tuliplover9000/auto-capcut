        {
          "cue": "the",
          "kind": "move",
          "who": "L",
          "name": "THE MORE YOU BUY"
        },
        {
          "cue": "save",
          "kind": "rain",
          "who": "L",
          "sprite": "gpu",
          "dmg": 60
        }
      ]
    },
    {
      "text": "Edison is on his last breath. And a museum test tube claims to hold it.",
      "note": "The Henry Ford museum, Michigan · its label: \"Edison's Last Breath?\"",
      "events": [
        {
          "cue": "test",
          "kind": "stat",
          "text": "EDISON'S LAST BREATH?"
        }
      ]
    },
    {
      "text": "The one thing that beats a GPU? He pulls the plug.",
      "note": "No power, no GPUs",
      "events": [

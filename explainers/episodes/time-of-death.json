        {
          "cue": "clock",
          "kind": "clock"
        }
      ]
    },
    {
      "text": "Alive, you're ninety-eight point six degrees.",
      "scene": "lab",
      "chapter": "THE RULES",
      "note": "",
      "pause": 0.1,
      "events": [
        {
          "cue": "ninety-eight",
          "kind": "alive"
        }
      ]
    },
    {
      "text": "After death, you lose about one and a half degrees every hour.",
      "scene": "lab",
      "chapter": "THE RULES",
      "note": "",
      "pause": 0.1,
      "events": [
        {
          "cue": "lose",
          "kind": "drop"

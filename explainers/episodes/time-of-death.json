        {
          "cue": "hour",
          "kind": "rate"
        }
      ]
    },
    {
      "text": "Six degrees down? Four hours dead.",
      "scene": "lab",
      "chapter": "THE RULES",
      "note": "",
      "pause": 0.15,
      "events": [
        {
          "cue": "Six",
          "kind": "six"
        },
        {
          "cue": "Four",
          "kind": "four"
        }
      ]
    },
    {
      "text": "But count back from when it was measured. Not when the body was found.",
      "scene": "lab",
      "chapter": "THE RULES",
      "note": "",
      "pause": 0.15,
      "events": [
        {
          "cue": "measured",
          "kind": "measured"

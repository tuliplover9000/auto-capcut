          "cue": "Eight",
          "kind": "eight"
        }
      ]
    },
    {
      "text": "Counted from ten, when the body was found? Six PM. That's A. The trap.",
      "scene": "test",
      "chapter": "THE ANSWER",
      "note": "",
      "pause": 0.2,
      "events": [
